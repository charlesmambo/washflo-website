<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Prevent Apache content negotiation from intercepting client-side routes.
  Options -MultiViews

  # Leave API requests for the configured backend.
  RewriteRule ^api/ - [L]

  # Serve real files and folders normally, and send app routes to Vite's entry point.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
